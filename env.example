# Telegram API Credentials
# Get these from https://my.telegram.org -> API development tools
API_ID=12345678
API_HASH=your_api_hash_here

# Chat IDs
# Use @userinfobot or @getidsbot to get chat IDs
# Supergroup/channel IDs look like: -1001234567890
# You can also use usernames: @username
SOURCE_CHAT=-1001234567890
DEST_CHAT=-1009876543210

# Delay between messages in seconds (default: 1.5)
# Lower = faster but higher risk of FloodWait
# Recommended: 1.5 - 2.0
DELAY_BETWEEN_MESSAGES=1.5

# Progress file name (default: forward_progress.json)
PROGRESS_FILE=forward_progress.json
